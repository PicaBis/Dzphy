# DzPhy — environment variables (copy to .env.local for local dev; set in Vercel for prod)
# NEVER commit real values. .env / .env*.local are gitignored.

# --- Admin Authentication ---------------------------------------------------
# Secret token for /admin panel access (server-side only)
ADMIN_SECRET=your-secure-admin-password-here

# --- Contact Form & Notifications -------------------------------------------
# Email service for contact form (optional, for future implementation)
RESEND_API_KEY=
ADMIN_EMAIL=your-admin-email@example.com

# Admin contact information (server-side only, NOT public)
ADMIN_WHATSAPP=213557972459
ADMIN_PAYMENT_NUMBER=00799999002885975343

# --- Supabase (persistent content storage) ---------------------------------
# Public (safe to expose to the browser):
NEXT_PUBLIC_SUPABASE_URL=https://gmuruowuodywknbpxvhk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server ONLY — must never be exposed to the browser or committed:
SUPABASE_SERVICE_ROLE_KEY=

# --- YouTube (optional) -----------------------------------------------------
# If set, the /api/playlists route uses the official YouTube Data API v3 for
# richer/full listings. If unset, it falls back to public RSS feeds (no key).
# Server-side only — never put this in NEXT_PUBLIC_*.
YOUTUBE_API_KEY=
