# DzPhy — environment variables (copy to .env.local for local dev; set in Vercel for prod)
# NEVER commit real values. .env / .env*.local are gitignored.
# This file only documents variable NAMES — every value below is a placeholder.

# --- Admin panel authentication (single shared password, server-side only) --
# Protects /admin via middleware.ts + /api/admin/login. Pick a long random
# value — this is NOT a per-user account system, see Supabase Auth below for
# that.
ADMIN_SECRET=

# --- Supabase (database + user authentication) ------------------------------
# Public / safe to expose to the browser (protected by Row Level Security):
#   Project URL — Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
#   Anon / "publishable" key — Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — must NEVER be exposed to the browser, committed, or logged.
# Settings → API → Project API keys → service_role (bypasses Row Level
# Security — used only by /api/admin/* and server-side content sync).
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (transactional email for the contact form) ----------------------
# https://resend.com/api-keys — SERVER ONLY, never expose to the browser.
RESEND_API_KEY=
# Where contact-form notifications are delivered:
ADMIN_EMAIL=
# Optional — must be a domain verified in Resend; defaults to the Resend
# sandbox sender if unset (fine for testing, not for production volume):
CONTACT_FROM_EMAIL=

# --- YouTube (optional) -----------------------------------------------------
# If set, the /api/playlists route uses the official YouTube Data API v3 for
# richer/full listings. If unset, it falls back to public RSS feeds (no key).
# Server-side only — never put this in NEXT_PUBLIC_*.
YOUTUBE_API_KEY=
